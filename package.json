{
  "name": "vter-desktop",
  "version": "1.0.0",
  "description": "Unofficial offline configurator for VTER Fighting68 keyboards",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "patch": "node patch-app.js",
    "dist": "npm run dist:linux",
    "dist:linux": "npm run patch && electron-builder --linux AppImage --publish never",
    "dist:win": "npm run patch && electron-builder --win portable --publish never",
    "dist:mac": "npm run patch && electron-builder --mac zip --x64 --arm64 --publish never",
    "deb": "npm run patch && electron-builder --linux dir --publish never && bash build-deb.sh"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "org.vteroffline.configurator",
    "productName": "VTER",
    "files": [
      "main.js",
      "preload.js",
      "site/**/*",
      "mock/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "Offline configurator for VTER keyboards",
      "description": "Configure lighting, key mapping, macros and sensitivity for VTER keyboards.",
      "artifactName": "VTER-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "VTER-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "artifactName": "VTER-${version}-mac-${arch}.${ext}"
    }
  }
}
